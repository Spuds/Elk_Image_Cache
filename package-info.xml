<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "https://www.elkarte.net/site/package-info">
<package-info xmlns="https://www.elkarte.net/site/package-info" xmlns:elk="https://www.elkarte.net/">
	<name>ImageCache</name>
	<id>spuds:imagecache</id>
	<type>addon</type>
	<version>2.0.0</version>

	<install for="2.0 Beta 1 - 2.0.99">
        <readme type="inline">This will install the Image Cache Addon for Elkarte.</readme>

        <require-dir name="ImageCache" destination="ADDONSDIR" />
        <require-dir name="languages/ImageCache" destination="LANGUAGEDIR" />
        <require-dir name="themes" destination="BOARDDIR">Templates, CSS, Scripts</require-dir>

        <require-file name="imagecache.php" destination="BOARDDIR">Proxy to serve images</require-file>
		<require-file name="RemoveOldImageCache.php" destination="ELKARTEDIR/ScheduledTasks/Tasks/">Scheduled Task</require-file>

        <database>install.php</database>
        <code>settings.php</code>

        <redirect url="$scripturl?action=admin;area=manageimagecache" timeout="5000" parsebbc="true">redirect</redirect>
	</install>

	<uninstall for="2.0 Beta 1 - 2.0.99">
		<hook reverse="true" hook="autoload_integrate" function="Image_Cache_Integrate" />
		<code>uninstall.php</code>
		<remove-file name="BOARDDIR/imagecache.php" />
		<remove-file name="THEMEDIR/css/imagecache.css" />
		<remove-file name="THEMEDIR/scripts/imagecache.js" />
        <remove-file name="THEMEDIR/images/admin/feature_ic.png" />
		<remove-file name="ELKARTEDIR/ScheduledTasks/Tasks/RemoveOldImageCache.php">Removing Scheduled Task</remove-file>

		<remove-dir name="ADDONSDIR/ImageCache" />
        <remove-dir name="LANGUAGEDIR/ImageCache" />
	</uninstall>

</package-info>
